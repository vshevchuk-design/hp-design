{
  "family": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Sora",
      "$description": "Latin/Latin-ext only on Google Fonts — no Cyrillic. Confirmed fine: product is English-only."
    }
  },
  "weight": {
    "normal": {
      "$type": "fontWeight",
      "$value": 400
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "size": {
    "xxs": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "base": {
      "$type": "dimension",
      "$value": {
        "value": 14,
        "unit": "px"
      },
      "$description": "The product's default UI text size (this is an app, not a marketing site) — deliberately 14px, not the 16px 'base' convention from Tailwind/browser defaults. Same pattern as Linear/Stripe Dashboard/Notion."
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": {
        "value": 30,
        "unit": "px"
      }
    },
    "4xl": {
      "$type": "dimension",
      "$value": {
        "value": 36,
        "unit": "px"
      },
      "$description": "Not consumed by any text-style yet — headroom for e.g. a stat-tile hero number."
    },
    "5xl": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "Not consumed by any text-style yet — headroom for e.g. a stat-tile hero number."
    }
  },
  "leading": {
    "none": {
      "$type": "number",
      "$value": 1
    },
    "tight": {
      "$type": "number",
      "$value": 1.2
    },
    "normal": {
      "$type": "number",
      "$value": 1.4
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.6
    },
    "$description": "Unitless ratios (CSS best practice for line-height — a percentage/px value inherits into children unexpectedly; unitless doesn't). 1.4 = the Figma source's 140%, etc."
  },
  "tracking": {
    "normal": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "em"
      }
    },
    "wide": {
      "$type": "dimension",
      "$value": {
        "value": 0.04,
        "unit": "em"
      },
      "$description": "Added for all-caps label styles — caps text at 0 tracking reads cramped; ~0.04em is a standard fix (Material uses ~0.05em for overline/caps)."
    }
  }
}