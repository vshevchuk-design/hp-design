{
  "component": {
    "dateRangePicker": {
      "$description": "A date-range picker for the console toolbar — a period navigator (‹ prev · start date · period label · end date · next ›) that opens a month-grid calendar where you pick a start then an end day; the range in between highlights. The arrows step the range by one period (month), and the middle label names it ('Current' for this month, otherwise the month). Built on the same field + Popover recipes as the single DatePicker, extended with range day states. Its driving use case is filtering the threads console by a date window.",
      "nav": {
        "height": { "$type": "dimension", "$value": "{dim.10}", "$description": "40px = the base field height." },
        "radius": { "$type": "dimension", "$value": "{radius.default}" },
        "bg": { "$type": "color", "$value": "{surface.dim}" },
        "border": { "$type": "color", "$value": "{border.default}" },
        "borderHover": { "$type": "color", "$value": "{border.strong}" },
        "borderFocus": { "$type": "color", "$value": "{border.focus}" },
        "divider": { "$type": "color", "$value": "{border.default}", "$description": "hairline between the arrows / fields / label." },
        "value": { "$type": "typography", "$value": "{text-style.body-sm}" },
        "valueColor": { "$type": "color", "$value": "{text.default}" },
        "label": { "$type": "typography", "$value": "{text-style.body-sm}", "$description": "The middle period label." },
        "labelColor": { "$type": "color", "$value": "{text.secondary}" },
        "arrowIcon": { "$type": "color", "$value": "{icon.default}" },
        "arrowHoverBg": { "$type": "color", "$value": "{fill.neutralHover}" },
        "fieldHoverBg": { "$type": "color", "$value": "{fill.neutralHover}" }
      },
      "panel": {
        "bg": { "$type": "color", "$value": "{surface.default}" },
        "border": { "$type": "color", "$value": "{border.default}" },
        "radius": { "$type": "dimension", "$value": "{radius.default}" },
        "padding": { "$type": "dimension", "$value": "{dim.3}" },
        "shadow": { "$type": "shadow", "$value": "{shadow.sm}" }
      },
      "header": {
        "label": { "$type": "typography", "$value": "{text-style.heading-sm}" },
        "labelColor": { "$type": "color", "$value": "{text.default}" },
        "navIcon": { "$type": "color", "$value": "{icon.default}" },
        "navHoverBg": { "$type": "color", "$value": "{fill.neutralHover}" },
        "navSize": { "$type": "dimension", "$value": "{dim.8}" }
      },
      "weekday": {
        "label": { "$type": "typography", "$value": "{text-style.label-sm}" },
        "color": { "$type": "color", "$value": "{text.muted}" }
      },
      "day": {
        "size": { "$type": "dimension", "$value": "{dim.9}", "$description": "36px square day cell." },
        "radius": { "$type": "dimension", "$value": "{radius.default}" },
        "label": { "$type": "typography", "$value": "{text-style.body-sm}" },
        "color": { "$type": "color", "$value": "{text.default}" },
        "hoverBg": { "$type": "color", "$value": "{fill.neutralHover}" },
        "todayBorder": { "$type": "color", "$value": "{border.strong}" },
        "endsBg": { "$type": "color", "$value": "{fill.primary}", "$description": "The start and end days fill solid." },
        "endsText": { "$type": "color", "$value": "{text.onFill}" },
        "rangeBg": { "$type": "color", "$value": "{bg.primary}", "$description": "Days between start and end get a light primary wash." },
        "rangeText": { "$type": "color", "$value": "{text.default}" },
        "outsideColor": { "$type": "color", "$value": "{text.muted}" }
      },
      "footer": {
        "gap": { "$type": "dimension", "$value": "{dim.2}" },
        "paddingTop": { "$type": "dimension", "$value": "{dim.3}" }
      }
    }
  }
}
